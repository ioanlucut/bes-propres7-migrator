{
  "name": "bes-propres7-migrator",
  "version": "1.0.0",
  "description": "Songs as code for ProPresenter 7: compiles a Git-managed song library into native .pro presentations and ships only what changed to the presentation Mac.",
  "keywords": [
    "songs-as-code",
    "propresenter",
    "propresenter7",
    "protobuf",
    "reverse-engineering",
    "church",
    "worship",
    "lyrics",
    "google-drive",
    "typescript"
  ],
  "homepage": "https://github.com/ioanlucut/bes-propres7-migrator#readme",
  "bugs": {
    "url": "https://github.com/ioanlucut/bes-propres7-migrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioanlucut/bes-propres7-migrator.git"
  },
  "license": "Apache-2.0",
  "author": "Ioan Lucut",
  "main": "index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:ci": "NODE_ENV=test TZ='Europe/Bucharest' jest --runInBand --no-cache",
    "test:watch": "NODE_ENV=test TZ='Europe/Bucharest' jest --watch --logHeapUsage",
    "test": "is-ci-cli test:ci test:watch",
    "convert:local": "dotenv -e .env.local ts-node runner.ts",
    "convert:remote": "dotenv -e .env.remote ts-node runner.ts",
    "lint": "eslint src runner.ts index.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src runner.ts index.ts jest.config.ts \"**/*.md\" \".github/**/*.yml\"",
    "test:sync-script": "bash client-sync-macos/template/sync-via-gdrive.test.sh"
  },
  "dependencies": {
    "@googleapis/drive": "^8.7.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "fs-extra": "^11.2.0",
    "google-protobuf": "^3.21.2",
    "lodash": "^4.17.21",
    "p-map": "^4.0.0",
    "protobufjs": "^7.2.6",
    "recursive-readdir": "^2.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^18.12.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.6",
    "@types/recursive-readdir": "^2.2.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "is-ci-cli": "^2.2.0",
    "jest": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^1.171.0",
    "tslib": "^2.6.2",
    "typescript": "5.1.6"
  }
}
